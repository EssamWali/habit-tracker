# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only ever the `anon` `public` key here. The `service_role` key bypasses RLS
# entirely and must never appear in this repo or in any client bundle.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# VAPID public key for web push (V2-6). Public by design: it is shipped in the
# bundle and identifies the sender to the push service. The matching PRIVATE key
# is a secret and lives only in Supabase's edge function secrets, never here.
VITE_VAPID_PUBLIC_KEY=<vapid public key>
